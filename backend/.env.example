# Flask
JWT_SECRET_KEY=change_this_super_secret
PORT=5000
FLASK_DEBUG=false

# MySQL (contenedor docker-compose). Debe coincidir con .env de la raíz (MYSQL_*)
DATABASE_URL=mysql+pymysql://skinatlas:change_mysql_password@mysql:3306/skinatlas

# Primer admin (opcional): POST /api/admin/bootstrap con cabecera X-Admin-Bootstrap-Token
ADMIN_BOOTSTRAP_TOKEN=

# ── Correo Gmail API ──
MAIL_ENABLED=true
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=

# URL pública del sitio (enlaces en correos y sitemap)
APP_PUBLIC_URL=https://globalskinmetrics.com
SITE_URL=https://globalskinmetrics.com
MAIL_LOGO_URL=

# Buzón que recibe los mensajes del formulario de contacto
CONTACT_INBOX_EMAIL=jllorenspadilla@gmail.com
CONTACT_REPLY_ENABLED=true
SITE_NAME=Global Skin Metrics

# Refresco automático de cachés (1=activo)
ENABLE_SCHEDULER=1
ENABLE_CACHE_WARMUP=1
SCHEDULER_TZ=Europe/Madrid
CATALOG_REFRESH_HOUR=4
PRICE_INDEX_REFRESH_HOURS=4

# AdSense
ADSENSE_PUBLISHER_ID=pub-7858627003457160
